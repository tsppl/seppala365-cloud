// SHARED DATASET - LATEST AGENT INVENTORY
// ============================================================
let LocalAgents = materialize(
    AgentsInfo
    | where Platform == "LocalAgents"
    | summarize arg_max(Timestamp, *) by AgentId
    | where LifecycleStatus !in~ ("Deleted", "Uninstalled")
    | extend M = RawAgentInfo.localAgentMetadata
    | extend Vendor = tostring(M.vendor),
             AccountName = tostring(M.accountName),
             AccountDomain = tostring(M.accountDomain),
             UPN = tostring(M.upn),
             OrgId = tostring(M.orgId),
             Device = tostring(M.deviceName),
             AADDeviceId = tostring(M.aadDeviceId),
             OS = tostring(M.osPlatform),
             OSVersion = tostring(M.osVersion),
             DeviceType = tostring(M.deviceType),
             DeviceSubtype = tostring(M.deviceSubtype),
             Process = tostring(M.relatedProcess),
             TrustedProcess = tolower(tostring(M.trustedProcess)),
             AutoApprove = tolower(tostring(M.autoApprove)),
             RemoteMcpCount = coalesce(array_length(McpServers), 0),
             LocalMcpCount = coalesce(array_length(M.localMcps), 0),
             LocalMcps = M.localMcps
    | extend Account = case(
        isnotempty(UPN), UPN,
        isnotempty(AccountDomain) and isnotempty(AccountName), strcat(AccountDomain, "\\", AccountName),
        isnotempty(AccountName), AccountName,
        ""
    )
    | project Timestamp, AgentId, Name, Vendor, Version,
              Account, AccountName, AccountDomain, UPN, OrgId,
              Device, AADDeviceId, OS, OSVersion, DeviceType, DeviceSubtype,
              Process, TrustedProcess, AutoApprove,
              RemoteMcpCount, LocalMcpCount, McpServers, LocalMcps
);
